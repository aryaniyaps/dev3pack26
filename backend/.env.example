PORT=8080
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ruby_dev?sslmode=disable
SOLANA_RPC_URL=https://api.devnet.solana.com
HELIUS_API_KEY=
SENDAI_API_KEY=
AUTH_JWT_SECRET=dev-change-me
AUTH_SESSION_TTL_MINUTES=10080
AUTH_DOMAIN=localhost:3000
# Production (Render): must match the host users see in the browser (embedded in Phantom SIWS text).
# AUTH_DOMAIN=rubydev3pack.vercel.app
# Comma-separated browser origins allowed to call this API with credentials (HttpOnly session cookie).
# Include the production Vercel origin when the API is on another host (e.g. Render).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://rubydev3pack.vercel.app
# HttpOnly Ruby session cookie (defaults: name ruby_session; production: Secure=true, SameSite=None for cross-site SPA).
# SESSION_COOKIE_NAME=
# SESSION_COOKIE_SECURE=
# SESSION_COOKIE_SAMESITE=
BLINK_BASE_URL=http://localhost:3000/blinks
PRIVY_APP_ID=
PRIVY_ISSUER=https://auth.privy.io
# Recommended: same PRIVY_APP_ID as NEXT_PUBLIC_PRIVY_APP_ID on the frontend. JWKS for ES256 access tokens:
# PRIVY_JWKS_URL=https://auth.privy.io/api/v1/apps/<YOUR_PRIVY_APP_ID>/jwks.json
PRIVY_JWKS_URL=
# Optional: static ES256 PEM when not using JWKS (Dashboard → App settings → Verification key).
PRIVY_VERIFICATION_KEY=
# Optional: Privy app secret for server-side Privy APIs (never expose to the browser; do not use NEXT_PUBLIC_*).
PRIVY_APP_SECRET=
AGENT_AUTO_RUN=false
AGENT_INTERVAL_SECONDS=86400
RUBY_PROGRAM_ID=BsHiSX9NmkNMTYP8UcAY71aKVZwcCgA2Tea1tmgeQbdv
SWIG_PROGRAM_ID=Swig111111111111111111111111111111111111111
TOKEN_2022_PROGRAM_ID=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
# Committed IDL (same artifact as anchor build).
# Render Root Directory = . (repo root): ANCHOR_IDL_PATH=contracts/idl/ruby_protocol.json
# Local run with cwd = backend/: ANCHOR_IDL_PATH=../contracts/idl/ruby_protocol.json
# Absolute on Render: ANCHOR_IDL_PATH=/opt/render/project/src/contracts/idl/ruby_protocol.json
ANCHOR_IDL_PATH=../contracts/idl/ruby_protocol.json
MIN_RESERVE_LAMPORTS=100000000
DEPLOY_PERCENT=90
KAMINO_APY_BPS=750
JITO_APY_BPS=620
